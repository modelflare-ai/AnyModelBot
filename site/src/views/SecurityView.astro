---
import Base from "../layouts/Base.astro";
import { dict, fmt, type Lang } from "../i18n";
import { SECURITY_EMAIL } from "../lib/site";
import "../styles/pages.css";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const s = t.security;
const n = t.flow.nodes;
const cmp = t.flow.compare;
const stays = (["chats", "memory", "workspace", "key", "console"] as const).map((k) => n[k]);
---
<Base lang={lang} path="/security" title={s.title} description={s.description}>
  <article class="container page prose">
    <header class="page__head"><h1>{s.h1}</h1><p class="lead">{s.lead}</p></header>
    <h2>{s.stays}</h2>
    <ul class="ticks" role="list">{stays.map((x) => <li><b>{x.label}</b> — {x.body}</li>)}</ul>
    <h2>{s.leaves}</h2>
    <ul class="ticks" role="list">{s.leavesItems.map((x) => <li>{x}</li>)}</ul>
    <p class="small page__aside"><a href={t.flow.retentionUrl} target="_blank" rel="noopener">{t.flow.retentionLink}</a></p>
    <h2>{cmp.caption}</h2>
    <div class="table-wrap compare">
      <table class="table">
        <thead><tr>{cmp.head.map((h, i) => (i === 0 ? <td></td> : <th scope="col">{h}</th>))}</tr></thead>
        <tbody>{cmp.rows.map((r) => <tr><th scope="row">{r[0]}</th><td data-label={cmp.head[1]}>{r[1]}</td><td data-label={cmp.head[2]}>{r[2]}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="small muted page__aside">{cmp.note}</p>
    <h2>{s.guardsTitle}</h2>
    <ol class="ticks" role="list">{t.oss.facts.map((f) => <li>{f.text} <code class="small muted">{f.path}</code></li>)}</ol>
    <h2>{s.limitsTitle}</h2>
    <ul class="ticks" role="list">{s.limits.map((x) => <li>{x}</li>)}</ul>
    <p class="page__cta">{fmt(s.report, { email: SECURITY_EMAIL })}</p>
  </article>
</Base>
