---
// 首页"看演示"（§6.1 次 CTA）：7 幕动画导览，界面照 App 的原生样式画（ui/design 的 token、ui/screens/onboarding.js、
// new-bot.js、chat.js）：环境光 + 毛玻璃侧栏 + 浮起的主面板 + 玻璃输入框，按钮、输入框、审批卡、模型选择器都按 App 的尺寸和层次。
// 节奏：每幕 6–8.5 秒，一共不到一分钟；点开就从第 1 幕自动播，播完从头再来，关掉才停。
// 切换：舞台下面一排步骤标签（编号 + 名称 + 这一幕的进度线），点哪一幕看哪一幕；舞台两侧的箭头和 ← → 键前后翻。切过去接着往下播。
// 时间线由 scripts/tour.ts 驱动：data-at（毫秒）到点加 .on；data-type 逐字打出；data-fill 画进度条；
// data-steps 切整幕的状态（busy：侧栏亮绿点、发送钮变停止；pick：模型选择器打开）；data-states 驱动机器人。
// 减少动态效果时每幕直接显示完成态，仍按时翻页。整块是示意，对读屏只读标题和字幕。
import "../styles/tour.css";
import BotFace from "./BotFace.astro";
import Icon from "./Icon.astro";
import { dict, fmt, type Lang } from "../i18n";
import { pricing } from "../lib/site";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const u = t.tour.ui;
const bots = t.bots.chars;
const isZh = lang === "zh";
const cps = isZh ? 34 : 64;            // 回复逐字打出的速度：英文字母多，快一点，两种语言差不多同时写完
const durations = [6000, 8000, 7000, 7500, 8000, 8500, 6500];
const connected = fmt(u.connected, { n: pricing.counts.text });
const code = u.botNameValue;           // 第 4 幕新建的机器人，第 5、6 幕和它聊

// App 的线稿图标（细线、圆头），只在演示里用
const I = {
  plus: '<path d="M12 5v14M5 12h14"/>',
  edit: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  panel: '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M15 4v16"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4-4"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M12 3.5v2.2M12 18.3v2.2M20.5 12h-2.2M5.7 12H3.5M18 6l-1.6 1.6M7.6 16.4 6 18M18 18l-1.6-1.6M7.6 7.6 6 6"/>',
  shield: '<path d="M12 3.5 19 6v5.5c0 4.2-3 7.6-7 9-4-1.4-7-4.8-7-9V6l7-2.5Z"/>',
  down: '<path d="m6 9 6 6 6-6"/>',
  right: '<path d="m9 6 6 6-6 6"/>',
  up: '<path d="M12 19V5M5 12l7-7 7 7"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  doc: '<path d="M7 3.5h6.5L18 8v11a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 19V5a1.5 1.5 0 0 1 1-1.5Z"/><path d="M13 3.5V8h5M9 12.5h6M9 16h4"/>',
  chat: '<path d="M5 18.5V6.5A2.5 2.5 0 0 1 7.5 4h9A2.5 2.5 0 0 1 19 6.5v6a2.5 2.5 0 0 1-2.5 2.5H9l-4 3.5Z"/>',
  file: '<path d="M7 3.5h6.5L18 8v11a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 19V5a1.5 1.5 0 0 1 1-1.5Z"/><path d="M13 3.5V8h5"/>',
  terminal: '<rect x="3" y="4.5" width="18" height="15" rx="2.5"/><path d="m7.5 10 3 2.5-3 2.5M12.5 15.5h4"/>',
  copy: '<rect x="8" y="8" width="12" height="12" rx="2.5"/><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8"/>',
  memory: '<path d="M12 4.5 19.5 8 12 11.5 4.5 8 12 4.5Z"/><path d="m4.5 12 7.5 3.5 7.5-3.5M4.5 16l7.5 3.5 7.5-3.5"/>',
};
const ic = (d: string, size = 16) => `<svg class="tw-ic" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
// 侧栏的机器人行（第 4–6 幕）：头像 + 名称 + 时间 + 一行预览
const sideRows = [
  { k: "red" as const, name: code, when: "21:08" },
  { k: "blue" as const, name: bots.blue.name, when: "20:46", snip: bots.blue.bot },
  { k: "green" as const, name: bots.green.name, when: "18:30", snip: bots.green.bot },
];
const pickerGroups = [
  ["GPT", ["gpt-5.6-sol", "gpt-6-sol"]],
  ["Claude", ["claude-sonnet-5-5", "claude-opus-5-5"]],
] as const;
const fams = [["GPT", 10], ["Claude", 9], ["Gemini", 8], ["DeepSeek", 3]] as const;
const claude = ["claude-opus-5-5", "claude-sonnet-5-5", "claude-haiku-5-5"];
const tplIcons = [I.file, I.chat, I.terminal];
---
<dialog class="sheet tour" id="demo-tour" aria-labelledby="tour-title" data-tour>
  <div class="sheet__head">
    <h2 class="h3" id="tour-title">{t.tour.title}</h2>
    <button class="icon-btn" type="button" data-close-dialog aria-label={t.ui.close}><Icon name="close" /></button>
  </div>

  <div class="tour__viewport">
    <div class="tour__stage" aria-hidden="true">

      <!-- 1 下载安装：下载按钮 → 安装进度 → App 打开到首屏 -->
      <section class="tour__scene tour__scene--desk" data-scene="0" data-duration={durations[0]}>
        <div class="tdl">
          <span class="btn btn--primary tw-press" data-at="500"><Icon name="download" />{t.download.generic}</span>
          <div class="tdl__bar on-fade" data-at="800">
            <span class="tdl__row"><span>{u.installing}</span><span class="tdl__pct mono" data-fill-text="900:2900"></span></span>
            <i><b data-fill="900:2900"></b></i>
          </div>
        </div>
        <div class="tw tw--bare tdl__app on-rise" data-at="3200">
          <span class="tw__lights"><i></i><i></i><i></i></span>
          <div class="tob">
            <BotFace char="blue" size={88} lively />
            <b class="tob__title">{u.slogan}</b>
            <span class="tw-btn tw-btn--primary tw-btn--lg tw-btn--block">{u.login}</span>
          </div>
        </div>
      </section>

      <!-- 2 登录 Modelflare：按钮 → 等浏览器 → 浏览器里授权 → 回来已连接 -->
      <section class="tour__scene" data-scene="1" data-duration={durations[1]}>
        <div class="tw tw--bare">
          <span class="tw__lights"><i></i><i></i><i></i></span>
          <div class="tob">
            <BotFace char="blue" size={88} lively data-states={JSON.stringify([[0, "idle"], [800, "thinking"], [5600, "idle"]])} data-shots={JSON.stringify([[5600, "done"]])} />
            <b class="tob__title">{u.slogan}</b>
            <div class="by-time tob__cta">
              <span><span class="tw-btn tw-btn--primary tw-btn--lg tw-btn--block tw-press" data-at="600">{u.login}</span></span>
              <span class="tob__wait" data-at="900"><span class="tw-spin"></span>{u.loginWait}</span>
              <span class="tob__ok" data-at="5500"><i class="tw-dot"></i>{connected}</span>
            </div>
            <span class="tob__links on-fade" data-at="900"><span class="tob__off" data-at="5500"></span><span>{u.loginReopen}</span><span><Fragment set:html={ic(I.copy, 13)} />{u.loginCopy}</span><span>{u.loginCancel}</span></span>
          </div>
        </div>
        <!-- 系统浏览器：盖在 App 上面，授权完退下去 -->
        <div class="tbr" data-at="1600">
          <span class="tbr__out" data-at="4700"></span>
          <div class="tbr__bar"><span class="tw__lights"><i></i><i></i><i></i></span><span class="tbr__url mono">modelflare.dev/authorize</span></div>
          <div class="tbr__body">
            <span class="tbr__brand">Modelflare</span>
            <b>{u.authTitle}</b>
            <small>{u.authSub}</small>
            <span class="tbr__btn tw-press" data-at="3900">{u.authBtn}</span>
          </div>
        </div>
      </section>

      <!-- 3 选默认模型：引导页的玻璃卡片——已连接 → 筛选 → 选中 → 开始对话 -->
      <section class="tour__scene" data-scene="2" data-duration={durations[2]}>
        <div class="tw tw--bare">
          <span class="tw__lights"><i></i><i></i><i></i></span>
          <div class="tob tob--step">
            <div class="tob__mini"><BotFace char="blue" size={40} /><b>{u.slogan}</b></div>
            <div class="tw-sheet">
              <span class="tob__ok tob__ok--lg"><i class="tw-dot"></i>{connected}</span>
              <span class="tw-hint">{u.pickHint}</span>
              <span class="tw-field" data-at="700"><span class="tw-field__ph">{u.filter}</span><span class="tw-typed mono" data-at="800" data-type="claude" data-cps="9"></span></span>
              <div class="by-time tw-pick">
                <div>{fams.map(([f, n]) => <span class="tw-fam"><b>{f}</b><span class="tw-fam__n">{n}</span><Fragment set:html={ic(I.right, 12)} /></span>)}</div>
                <div data-at="1300">
                  <span class="tw-group">Claude</span>
                  {claude.map((m) => <span class:list={["tw-opt", "mono", { "tw-opt--pick tw-press": m === "claude-sonnet-5-5" }]} data-at={m === "claude-sonnet-5-5" ? "2600" : undefined}><span>{m}</span><Fragment set:html={ic(I.check, 14)} /></span>)}
                </div>
              </div>
              <span class="tw-btn tw-btn--primary tw-btn--lg tw-btn--block tw-press" data-at="4800">{u.start}</span>
            </div>
          </div>
        </div>
      </section>

      <!-- 4 新建机器人：点"代码助手"模板 → 角色、名称跟着换 → 创建 → 侧栏里多了一行 -->
      <section class="tour__scene" data-scene="3" data-duration={durations[3]}>
        <div class="tw">
          <div class="tw__side">
            <div class="tw__top"><span class="tw__lights"><i></i><i></i><i></i></span><span class="tw-ib tw-ib--on"><Fragment set:html={ic(I.plus)} /></span></div>
            <div class="tw__search"><Fragment set:html={ic(I.search, 14)} />{u.search}</div>
            <div class="tw__list">
              <div class="tw-row is-sel by-time">
                <span><span class="tw-row__av"><BotFace char="blue" size={30} class="neutral" /></span><span class="tw-row__body"><b>{u.newBot}</b><span class="tw-row__snip">{u.creating}</span></span></span>
                <span data-at="4500"><span class="tw-row__av"><BotFace char="red" size={30} /></span><span class="tw-row__body"><b>{code}</b><span class="tw-row__snip">{u.noChat}</span></span></span>
              </div>
            </div>
            <div class="tw__acct"><span class="tw__me">M</span><span class="tw__who">Modelflare<small class="tnum">$12.40</small></span><Fragment set:html={ic(I.gear)} /></div>
          </div>
          <div class="tw__main">
            <div class="tw-head">
              <span class="by-time tw-head__bot"><span><BotFace char="blue" size={22} /><b>{u.newBot}</b></span><span data-at="1000"><BotFace char="red" size={22} /><b>{u.newBot}</b></span></span>
              <span class="tw-grow"></span>
              <span class="tw-ib"><Fragment set:html={ic(I.close)} /></span>
            </div>
            <div class="tnew">
              <div class="by-time tnew__face"><span><BotFace char="blue" size={56} lively /></span><span data-at="1000"><BotFace char="red" size={56} lively /></span></div>
              <b class="tnew__title">{u.newFirst}</b>
              <div class="tnew__pick">
                {(["blue", "yellow", "green", "red", "purple", "orange"] as const).map((k) => (
                  <span class:list={["tav", { "tav--first": k === "blue" }]} data-at={k === "red" ? "1000" : undefined}><BotFace char={k} size={28} /><small>{bots[k].name}</small></span>
                ))}
              </div>
              <div class="tnew__field">
                <span class="tnew__k">{u.botName}</span>
                <span class="tw-field tw-field--lg" data-at="1000"><span class="by-time"><span class="tw-field__ph">{u.botNamePh}</span><span data-at="1000">{code}</span></span></span>
              </div>
              <span class="tw-btn tw-btn--primary tw-btn--lg tnew__go tw-press" data-at="3700"><span class="by-time"><span>{u.create}</span><span data-at="3800"><span class="tw-spin tw-spin--on"></span>{u.creating}</span></span></span>
              <div class="tnew__tpls">
                <span class="tnew__head">{u.templates}</span>
                <div class="tnew__grid">
                  {u.tpls.map((x, i) => (
                    <span class:list={["tpl", { "tpl--pick tw-press": i === 2 }]} data-at={i === 2 ? "800" : undefined}>
                      <span class="tpl__ic"><Fragment set:html={ic(tplIcons[i], 18)} /></span><b>{x.name}</b><small>{x.desc}</small>
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- 5 开聊、换模型：提问 → 思考中 → 回复逐字出来 → 点输入框里的模型 → 选择器里换一个 -->
      <section class="tour__scene" data-scene="4" data-duration={durations[4]}>
        <div class="tw" data-steps={JSON.stringify([[0, "idle"], [900, "busy"], [3700, "idle"], [4300, "pick"], [5800, "idle"]])}>
          <div class="tw__side">
            <div class="tw__top"><span class="tw__lights"><i></i><i></i><i></i></span><span class="tw-ib"><Fragment set:html={ic(I.plus)} /></span></div>
            <div class="tw__search"><Fragment set:html={ic(I.search, 14)} />{u.search}</div>
            <div class="tw__list">
              {sideRows.map((r, i) => (
                <div class:list={["tw-row", { "is-sel": i === 0 }]}>
                  <span class="tw-row__av"><BotFace char={r.k} size={30} />{i === 0 && <i class="tw-row__dot"></i>}</span>
                  <span class="tw-row__body"><span class="tw-row__line"><b>{r.name}</b><small class="tnum">{r.when}</small></span>
                    {i === 0 ? <span class="tw-row__snip by-busy"><span>{u.chatUser}</span><span>{u.working}</span></span> : <span class="tw-row__snip">{r.snip}</span>}</span>
                </div>
              ))}
            </div>
            <div class="tw__acct"><span class="tw__me">M</span><span class="tw__who">Modelflare<small class="tnum">$12.40</small></span><Fragment set:html={ic(I.gear)} /></div>
          </div>
          <div class="tw__main">
            <div class="tw-head">
              <span class="tw-head__bot"><span><BotFace char="red" size={22} data-states={JSON.stringify([[0, "idle"], [900, "working"], [3700, "idle"]])} /><b>{code}</b></span></span>
              <span class="tw-grow"></span>
              <span class="tw-ib"><Fragment set:html={ic(I.edit)} /></span><span class="tw-ib"><Fragment set:html={ic(I.panel)} /></span>
            </div>
            <div class="tw-log">
              <div class="tw-item tw-item--static"><div><span class="tw-time">{u.today}</span></div></div>
              <div class="tw-item" data-at="300"><div><p class="tw-msg tw-msg--me">{u.chatUser}</p></div></div>
              <div class="tw-item" data-at="900"><div><p class="tw-work"><span class="by-time"><span class="tw-shimmer">{u.thinking}</span><span data-at="1900">{fmt(u.took, { s: "1.0s" })}</span></span></p></div></div>
              <div class="tw-item" data-at="1900"><div><p class="tw-msg tw-live"><span data-at="1900" data-type={u.chatReply} data-cps={cps}></span></p></div></div>
              <div class="tw-item" data-at="5900"><div><span class="tw-time tw-time--note">{fmt(u.switched, { model: "gpt-5.6-sol" })}</span></div></div>
            </div>
            <div class="tw-composer">
              <span class="tw-composer__ph">{fmt(u.input, { name: code })}</span>
              <span class="tw-composer__bar">
                <span class="tw-plus"><Fragment set:html={ic(I.plus)} /></span>
                <span class="tw-chip"><Fragment set:html={ic(I.shield, 13)} />{u.perm}<Fragment set:html={ic(I.down, 11)} /></span>
                <span class="tw-grow"></span>
                <span class="tw-chip tw-chip--model tw-press" data-at="4200"><span class="by-time"><span>claude-sonnet-5-5</span><span data-at="5700">gpt-5.6-sol</span></span><Fragment set:html={ic(I.down, 11)} /></span>
                <span class="tw-send"><Fragment set:html={ic(I.up, 15)} /><i></i></span>
              </span>
            </div>
            <!-- App 的模型选择器（.pop.model-picker）：从输入框里的模型胶囊往上弹 -->
            <div class="tw-pop">
              <span class="tw-pop__search"><Fragment set:html={ic(I.search, 14)} />{u.pickerSearch}</span>
              <ul>
                {pickerGroups.map(([g, ms]) => (
                  <>
                    <li class="tw-pop__group">{g}</li>
                    {ms.map((m) => <li class:list={["mono", { "tw-pop__cur": m === "claude-sonnet-5-5", "tw-pop__go tw-press": m === "gpt-5.6-sol" }]} data-at={m === "gpt-5.6-sol" ? "5000" : undefined}><span>{m}</span>{m === "claude-sonnet-5-5" && <Fragment set:html={ic(I.check, 14)} />}</li>)}
                  </>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- 6 让它动手：交代任务 → 一步步做 → 越界的那一步出审批卡 → 允许 → 交出文件 -->
      <section class="tour__scene" data-scene="5" data-duration={durations[5]}>
        <div class="tw" data-steps={JSON.stringify([[0, "idle"], [800, "busy"], [6500, "idle"]])}>
          <div class="tw__side">
            <div class="tw__top"><span class="tw__lights"><i></i><i></i><i></i></span><span class="tw-ib"><Fragment set:html={ic(I.plus)} /></span></div>
            <div class="tw__search"><Fragment set:html={ic(I.search, 14)} />{u.search}</div>
            <div class="tw__list">
              {sideRows.map((r, i) => (
                <div class:list={["tw-row", { "is-sel": i === 0 }]}>
                  <span class="tw-row__av"><BotFace char={r.k} size={30} />{i === 0 && <i class="tw-row__dot"></i>}</span>
                  <span class="tw-row__body"><span class="tw-row__line"><b>{r.name}</b><small class="tnum">{r.when}</small></span>
                    {i === 0 ? <span class="tw-row__snip by-busy"><span>{u.task}</span><span>{u.working}</span></span> : <span class="tw-row__snip">{r.snip}</span>}</span>
                </div>
              ))}
            </div>
            <div class="tw__acct"><span class="tw__me">M</span><span class="tw__who">Modelflare<small class="tnum">$12.40</small></span><Fragment set:html={ic(I.gear)} /></div>
          </div>
          <div class="tw__main">
            <div class="tw-head">
              <span class="tw-head__bot"><span><BotFace char="red" size={22} data-states={JSON.stringify([[0, "idle"], [800, "working"], [6500, "idle"]])} data-shots={JSON.stringify([[6500, "done"]])} /><b>{code}</b></span></span>
              <span class="tw-grow"></span>
              <span class="tw-ib"><Fragment set:html={ic(I.edit)} /></span><span class="tw-ib"><Fragment set:html={ic(I.panel)} /></span>
            </div>
            <div class="tw-log">
              <div class="tw-item tw-item--static"><div><span class="tw-time">{u.today}</span></div></div>
              <div class="tw-item" data-at="300"><div><p class="tw-msg tw-msg--me">{u.task}</p></div></div>
              <div class="tw-item" data-at="800"><div><p class="tw-work"><span class="by-time"><span class="tw-shimmer">{u.working}</span><span data-at="6400">{fmt(u.took, { s: "5.6s" })}</span></span></p></div></div>
              <div class="tw-item" data-at="1200"><div><ul class="tw-well tw-steps" role="list">{t.handson.demoSteps.map((x, i) => <li data-at={String(1200 + i * 450)}><Fragment set:html={ic(I.check, 13)} />{x}</li>)}</ul></div></div>
              <div class="tw-item" data-at="2700"><div>
                <div class="tw-well tw-card" data-at="4700">
                  <span class="tw-card__meta"><span>{u.approvalMeta} · <span class="tnum">4F2K</span></span><span class="tw-badge">{u.allowed}</span></span>
                  <b class="tw-card__q">{t.handson.approvalBody}</b>
                  <span class="tw-card__cmd mono">mv ~/Downloads/*.pdf ~/Documents/</span>
                  <span class="tw-card__acts"><span class="tw-btn tw-btn--primary tw-press" data-at="4400">{u.allowOnce}</span><span class="tw-btn">{u.deny}</span></span>
                </div>
              </div></div>
              <div class="tw-item" data-at="5400"><div><div class="tw-well tw-file"><Fragment set:html={ic(I.doc, 24)} /><span><b>{t.handson.file}</b><small>{u.fileSub}</small></span></div></div></div>
            </div>
            <div class="tw-composer">
              <span class="tw-composer__ph">{fmt(u.input, { name: code })}</span>
              <span class="tw-composer__bar">
                <span class="tw-plus"><Fragment set:html={ic(I.plus)} /></span>
                <span class="tw-chip"><Fragment set:html={ic(I.shield, 13)} />{u.perm}<Fragment set:html={ic(I.down, 11)} /></span>
                <span class="tw-grow"></span>
                <span class="tw-chip tw-chip--model"><span>gpt-5.6-sol</span><Fragment set:html={ic(I.down, 11)} /></span>
                <span class="tw-send"><Fragment set:html={ic(I.up, 15)} /><i></i></span>
              </span>
            </div>
          </div>
        </div>
      </section>

      <!-- 7 在聊天软件里找它：接入卡（已连接）+ 手机上一问一答 -->
      <section class="tour__scene tour__scene--phone" data-scene="6" data-duration={durations[6]}>
        <div class="tim">
          <div class="tw-sheet tim__card on-rise" data-at="200">
            <span class="tim__ic"><Fragment set:html={ic(I.chat, 20)} /></span>
            <b>{fmt(u.channelOk, { im: u.imFrom })}</b>
            <small>{u.channelSub}</small>
            <span class="tim__bot"><BotFace char="green" size={26} />{bots.green.name}<i class="tw-dot"></i></span>
          </div>
          <div class="phone tour__phone">
            <div class="phone__screen">
              <div class="phone__head"><BotFace char="green" size={30} data-states={JSON.stringify([[0, "idle"], [1900, "working"], [3600, "idle"]])} /><span class="tim__who"><b>{bots.green.name}</b><small>{u.imFrom}</small></span></div>
              <div class="phone__log">
                <span class="phone__day">{u.today}</span>
                <p class="msg msg--user on-rise" data-at="900">{u.imUser}</p>
                <p class="msg msg--bot on-rise" data-at="1900"><span data-at="2000" data-type={u.imReply} data-cps={isZh ? 18 : 34}></span></p>
              </div>
              <div class="phone__input">{t.bots.phoneInput}</div>
            </div>
          </div>
        </div>
      </section>
    </div>
    <button type="button" class="tour__arrow tour__arrow--prev" data-tour-prev aria-label={t.tour.prev}><Icon name="arrow" class="flip" size={18} /></button>
    <button type="button" class="tour__arrow tour__arrow--next" data-tour-next aria-label={t.tour.next}><Icon name="arrow" size={18} /></button>
  </div>

  <div class="tour__steps" role="tablist" aria-label={t.tour.steps}>
    {t.tour.scenes.map((s, i) => (
      <button type="button" role="tab" class="tour__step" data-goto={i} aria-selected={i === 0 ? "true" : "false"}>
        <span class="tour__step-n mono">{i + 1}</span><span class="tour__step-t">{s.title}</span><i class="tour__step-bar"></i>
      </button>
    ))}
  </div>
  <div class="tour__caption" aria-live="polite">
    {t.tour.scenes.map((s, i) => (
      <p data-caption={i} hidden={i !== 0}><b>{s.title}</b><span>{s.caption}</span></p>
    ))}
  </div>
  <p class="tour__note small muted">{t.tour.note}</p>
</dialog>
