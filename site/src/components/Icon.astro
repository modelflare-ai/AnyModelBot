const { name, size = 24, class: cls, label } = Astro.props;
const filled = name in F;
---
{filled
  ? <svg class:list={["icon", "icon--fill", cls]} width={size} height={size} viewBox="0 0 16 16" fill="currentColor"
      aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label}><path d={F[name as keyof typeof F]} /></svg>
  : <svg class:list={["icon", cls]} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
      stroke-linecap="round" stroke-linejoin="round" aria-hidden={label ? undefined : "true"} role={label ? "img" : undefined} aria-label={label}
      set:html={P[name as keyof typeof P]} />}
