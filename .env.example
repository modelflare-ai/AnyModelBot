# anymodel bot 环境变量（全部可选；环境变量优先于 <数据目录>/config.json）
# 复制为 .env 后由你的进程管理器/`docker run --env-file` 加载（程序本身不自动读取 .env）

# 数据目录（SQLite、magpie 隔离配置、微信登录态）。默认 ./data；桌面版默认 <userData>/data
# AMB_DATA_DIR=./data

# 管理界面。非回环地址（如 0.0.0.0）会强制令牌访问，令牌见 <数据目录>/ui-token
# AMB_UI_HOST=127.0.0.1
# AMB_UI_PORT=3600
# AMB_UI_TOKEN=

# 内置 magpie 可执行文件（默认自动查找 build/bin 或桌面版 resources/magpie）
# AMB_MAGPIE_BIN=
# 仅开发/测试：改用外部 OpenAI 兼容端点（设置后不启动内置网关，界面视为已连接、不显示 Modelflare 连接管理）
# AMB_MAGPIE_BASE_URL=http://127.0.0.1:8080/v1
# AMB_MAGPIE_API_KEY=
# 仅开发/测试：把 Modelflare 基址指向本地 mock（界面无法设置；正式使用只有 modelflare.dev 与 origin.modelflare.dev 两条线路）
# AMB_MODELFLARE_BASE_URL=http://127.0.0.1:8080/v1
# 仅开发/测试：把账户登录（OIDC 发现文档、授权、令牌）与账户接口指向本地 mock；正式使用固定为 https://modelflare.dev
# AMB_MODELFLARE_ISSUER=http://127.0.0.1:8080

# 对话
# AMB_DEFAULT_MODEL=openai/gpt-5.6-sol
# AMB_CONTEXT_MESSAGES=40
# AMB_CONTEXT_CHARS=24000

# 飞书（仅首次创建默认机器人时读取；之后在界面信息面板「渠道」里修改）
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=
# AMB_FEISHU_THROTTLE_MS=400

# 微信 iLink 接口地址（一般不用改）
# AMB_WEIXIN_API_BASE=https://ilinkai.weixin.qq.com

# Windows：代理执行命令用的 PowerShell。没有能用的 PowerShell 7 时应用会在后台自动装一份（%LOCALAPPDATA%\AnyModelBot\pwsh）
# AMB_PWSH_AUTO_INSTALL=0          # 不自动安装（设置 → 故障排查 里仍可手动安装）
# AMB_PWSH_MIRROR=https://…/       # 下载镜像前缀（后面接 PowerShell-<版本>-win-<架构>.zip；照样核对 SHA256 和签名）
# AMB_PWSH_HOME=                   # 安装位置
# AMB_PWSH_IGNORE_SYSTEM=1         # 仅测试：不用系统里的 PowerShell（CI 用它验证内置副本）

# 日志级别 debug|info|warn|error
# AMB_LOG_LEVEL=info
