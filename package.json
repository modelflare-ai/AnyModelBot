{
  "name": "anymodel-bot",
  "productName": "anymodel bot",
  "version": "0.1.35",
  "private": true,
  "description": "anymodel bot：任意模型的个人 AI 助手（飞书 + 微信 iLink），内置 magpie 模型网关",
  "license": "MIT",
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build:magpie": "node scripts/build-magpie.mjs",
    "build": "tsc -p tsconfig.build.json && npm run build:catalog",
    "build:catalog": "tsx scripts/build-catalog.ts",
    "prestart": "npm run build:catalog",
    "start": "tsx src/main.ts",
    "predev": "npm run build:catalog",
    "dev": "tsx watch src/main.ts",
    "preinit": "npm run build:catalog",
    "init": "tsx src/cli/init.ts",
    "weixin:login": "tsx src/cli/weixin-login.ts",
    "bot": "tsx src/cli/amb-bot.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "docs:check": "node scripts/check-readme.mjs",
    "i18n:check": "node scripts/i18n-check.mjs && tsx scripts/locales-check.ts && node scripts/check-readme.mjs --all-languages",
    "i18n:status": "tsx scripts/locales-check.ts --status",
    "electron:dev": "npm run build && electron .",
    "dist": "npm run i18n:check && npm run build && node scripts/prepare-dsh.mjs && node scripts/bundle-dsh.mjs && node scripts/build-magpie.mjs --target current && node scripts/fetch-cua-driver.mjs --target current && electron-builder",
    "electron:smoke": "npm run build && node scripts/electron-smoke.mjs",
    "dist:debug": "node scripts/dist-debug.mjs",
    "dist:linux": "npm run i18n:check && npm run build && node scripts/prepare-dsh.mjs --os linux --cpu x64 && node scripts/bundle-dsh.mjs --os linux --cpu x64 && node scripts/build-magpie.mjs --target linux/amd64,linux/arm64 && node scripts/fetch-cua-driver.mjs --target linux/x64,linux/arm64 && electron-builder --linux",
    "dist:mac": "npm run i18n:check && npm run build && node scripts/build-magpie.mjs --target darwin/amd64,darwin/arm64 && node scripts/fetch-cua-driver.mjs --target darwin/x64,darwin/arm64 && node scripts/prepare-dsh.mjs --os darwin --cpu arm64 && node scripts/bundle-dsh.mjs --os darwin --cpu arm64 && electron-builder --mac dmg zip --arm64 && node scripts/prepare-dsh.mjs --os darwin --cpu x64 && node scripts/bundle-dsh.mjs --os darwin --cpu x64 && electron-builder --mac dmg zip --x64",
    "dist:win": "npm run i18n:check && npm run build && node scripts/build-magpie.mjs --target windows/amd64,windows/arm64 && node scripts/fetch-cua-driver.mjs --target win32/x64,win32/arm64 && node scripts/prepare-dsh.mjs --os win32 --cpu x64 && node scripts/bundle-dsh.mjs --os win32 --cpu x64 && electron-builder --win nsis --x64 && node scripts/prepare-dsh.mjs --os win32 --cpu arm64 && node scripts/bundle-dsh.mjs --os win32 --cpu arm64 && electron-builder --win nsis --arm64",
    "prepare:dsh": "node scripts/prepare-dsh.mjs",
    "bundle:dsh": "node scripts/bundle-dsh.mjs",
    "test:dsh-bundle": "node scripts/test-dsh-bundle.mjs",
    "fetch:cua": "node scripts/fetch-cua-driver.mjs",
    "test:i18n:browser": "npm --prefix site run test:locales:browser"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/client": "2.2.0",
    "electron-updater": "6.8.12",
    "htm": "^3.1.1",
    "preact": "^11.0.2",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "3.4.0",
    "electron": "44.7.0",
    "electron-builder": "^26.18.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "author": {
    "name": "anymodel bot",
    "email": "support@anymodel.bot"
  },
  "build": {
    "appId": "dev.anymodel.bot",
    "productName": "anymodel bot",
    "artifactName": "anymodel-bot-${version}-${os}-${arch}.${ext}",
    "protocols": [
      {
        "name": "AnyModelBot",
        "schemes": [
          "anymodelbot"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "modelflare-ai",
      "repo": "AnyModelBot",
      "private": false,
      "channel": "latest-${arch}"
    },
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "dist/**",
      "ui/**",
      "assets/**",
      "!assets/icon.icns",
      "!assets/icons{,/**}",
      "package.json",
      "!**/*.map",
      "LICENSE",
      "THIRD_PARTY_NOTICES*.md",
      "CHANGELOG*.md",
      "LICENSES/**",
      "!dist/*-unpacked{,/**}",
      "!dist/win-unpacked{,/**}",
      "!dist/mac{,/**}",
      "!dist/linux*-unpacked{,/**}"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "extraResources": [
        {
          "from": "build/bin/magpie-darwin-${arch}",
          "to": "magpie/magpie"
        },
        {
          "from": "build/dsh",
          "to": "dsh",
          "filter": [
            "dsh.asar"
          ]
        },
        {
          "from": "build/dsh/node_modules",
          "to": "dsh/node_modules",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "vendor/kimi-computer-use",
          "to": "kimi-computer-use",
          "filter": [
            "bin/**",
            "skills/**",
            "package.json",
            "LICENSE",
            "NOTICE",
            "README.md"
          ]
        },
        {
          "from": "vendor/yuque-mcp",
          "to": "yuque-mcp",
          "filter": [
            "yuque-mcp.mjs",
            "LICENSE",
            "THIRD_PARTY_LICENSES.txt",
            "README.md"
          ]
        },
        {
          "from": "build/cua-driver/darwin-${arch}",
          "to": "cua-driver",
          "filter": [
            "cua-driver",
            "cua-driver.exe",
            "LICENSE",
            "THIRD_PARTY_NOTICES.md"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "build/bin/magpie-win32-${arch}.exe",
          "to": "magpie/magpie.exe"
        },
        {
          "from": "build/dsh",
          "to": "dsh",
          "filter": [
            "dsh.asar"
          ]
        },
        {
          "from": "build/dsh/node_modules",
          "to": "dsh/node_modules",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/cua-driver/win32-${arch}",
          "to": "cua-driver",
          "filter": [
            "cua-driver",
            "cua-driver.exe",
            "LICENSE",
            "THIRD_PARTY_NOTICES.md"
          ]
        },
        {
          "from": "vendor/yuque-mcp",
          "to": "yuque-mcp",
          "filter": [
            "yuque-mcp.mjs",
            "LICENSE",
            "THIRD_PARTY_LICENSES.txt",
            "README.md"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "assets/icons",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "build/bin/magpie-linux-${arch}",
          "to": "magpie/magpie"
        },
        {
          "from": "build/dsh",
          "to": "dsh",
          "filter": [
            "dsh.asar"
          ]
        },
        {
          "from": "build/dsh/node_modules",
          "to": "dsh/node_modules",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "build/cua-driver/linux-${arch}",
          "to": "cua-driver",
          "filter": [
            "cua-driver",
            "cua-driver.exe",
            "LICENSE",
            "THIRD_PARTY_NOTICES.md"
          ]
        },
        {
          "from": "vendor/yuque-mcp",
          "to": "yuque-mcp",
          "filter": [
            "yuque-mcp.mjs",
            "LICENSE",
            "THIRD_PARTY_LICENSES.txt",
            "README.md"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "StartupWMClass": "anymodel bot"
        }
      }
    }
  }
}
