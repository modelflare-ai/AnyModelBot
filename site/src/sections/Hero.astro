---
// 首页第一屏（动效参考 bevel.health，窗口照 App 的原生界面 ui/design 来）。四周留 8px 的圆角大卡片，从上到下——
//   小胶囊（六个角色头像 + 一句话，链到"认识你的机器人"）→ 标题（逐字由虚变实升起；第一行渐变字，行尾蹲着会看你、能戳的天天；
//   关键词品牌色 + 光晕，入场后一道亮光从左到右扫过）→ 一句说明 → 下载 / 演示 → 三条要点 → 舞台。
// 背景克制、全部静止：一层很淡的中性顶光（顶边淡入，不切出硬边）+ 顶部一层极淡的星空（小星点往下渐隐，少数几颗慢慢闪，偶尔划过一颗流星）→ 舞台后面一层极淡的机器人色 →
//   托住窗口的弧形"地平线"（一线淡亮边、正中稍亮）→ App 同款磨砂颗粒。颜色只在舞台换机器人时微微变（--hero-hue / --hz-glow），不用品牌黄绿。
// 舞台：一台 App 窗口（毛玻璃侧栏 + 浮起的主面板 + 玻璃输入框）+ 压在右下角的手机，循环 18 秒三幕，每幕换一个机器人：
//   一幕 天天 · 聊天改代码 → 二幕 飞飞 · 动手整理文件（要你批准）→ 三幕 芽芽 · 微信 / 飞书里来的消息，手机和窗口同步。
//   侧栏的选中行、顶栏、对话、输入框里的模型和窗口的环境光（App 的 --aura-hue）随幕切换。
//   宽屏两侧的卡片跟着节奏流动：左边的模型、任务、消息流进窗口，右边的结果、文件、记忆从窗口后面流出来。
// 时间线由 scripts/tour.ts 的 mountLoop 驱动（只在看得见时走表）：data-steps 切幕（data-step 写"a / b / c"，干活时再加"busy"），
// data-at 到点加 .on，data-type 逐字打出，data-flow 写卡片行程 --k，data-states / data-shots 驱动机器人。窗口的倾斜随滚动摆正（data-fx）。
// 减少动态效果时停在完成态（第三幕）、不放流动卡片；窄屏只留主面板。整块舞台是示意，对读屏隐藏。
import DownloadButton from "../components/DownloadButton.astro";
import Icon from "../components/Icon.astro";
import BotFace from "../components/BotFace.astro";
import HeroLogos from "../components/HeroLogos.astro";
import { dict, fmt, buildVars, type Lang } from "../i18n";
import { CHAR_KEYS, type CharKey } from "../lib/bots";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const v = buildVars(lang);
const s = t.hero.stage;
const u = t.tour.ui;
const bots = t.bots.chars;
const isZh = lang === "zh";
// 要点和"App 界面目前是简体中文"这类提示放在同一行小字里，不再单独占一行
const meta = [...t.hero.trust.map((x) => fmt(x, v)), ...(t.hero.appUiNote ? [t.hero.appUiNote] : [])];
// 顶部天空：在 1600 × 640 的画布上伪随机撒点，每次构建都一样、不成网格。两套，按主题只显示一套（home.css 的 .hero__sky）：
//   深色·星空（dots）：约 340 颗小星，标题背后那一块椭圆里只留约三成，字不会被打扰；约一成五偏冷蓝、一成偏暖，其余冷白；
//     少数亮星外面再套一圈极淡的光（h）。约五分之一的星（和所有亮星）慢慢明暗闪烁：周期 --d 3–7 秒、起点 --t 各不相同，不会一起闪。
//     另有两颗流星（.hero__meteor），隔十几、二十秒才划过一次。
//   浅色·晴空：顶上一片浅天蓝（home.css 的 .hero__bg）；白天没有星空，小灰点在白底上像灰尘——换成三朵很软的白云（.hero__cloud，纯 CSS，极慢地从左往右飘，横穿一次 3–5 分钟）
//     + 四十来个四角形的细小闪光（glints，✦），只在标题两侧和上方，大小 3–8、颜色跟着当前机器人的色调压得很淡；
//     约六成会亮起来、转一下再隐去（各自错开）。不放流星。
const GLINT = "M0-1C.1-.1.1-.1 1 0C.1.1.1.1 0 1C-.1.1-.1.1-1 0C-.1-.1-.1-.1 0-1Z";
const sky = (() => {
  let h = 20261031;
  const rnd = () => (h = (Math.imul(h, 1103515245) + 12345) >>> 0) / 2 ** 32;
  const twinkle = (o: number) => `--o:${o};--d:${(3 + rnd() * 4).toFixed(1)}s;--t:-${(rnd() * 7).toFixed(1)}s`;
  const inTitle = (x: number, y: number) => { const dx = (x - 800) / 540, dy = (y - 300) / 270; return dx * dx + dy * dy < 1; };
  const dots: { x: number; y: number; r: number; o: number; cls?: string; tw?: string }[] = [];
  while (dots.length < 340) {
    const x = +(rnd() * 1600).toFixed(1), y = +(rnd() * 640).toFixed(1);
    if (inTitle(x, y) && rnd() < 0.7) continue;
    const big = rnd() < 0.06;
    const tint = rnd();
    const cls = tint < 0.15 ? "c" : tint < 0.25 ? "w" : undefined;
    if (big) dots.push({ x, y, r: 4.4, o: 0.09, cls: "h" }, { x, y, r: 1.35, o: 0.95, cls, tw: twinkle(0.95) });
    else {
      const o = +(0.35 + rnd() * 0.5).toFixed(2);
      dots.push({ x, y, r: +(0.55 + rnd() * 0.65).toFixed(2), o, cls, ...(rnd() < 0.2 ? { tw: twinkle(o) } : {}) });
    }
  }
  const glints: { x: number; y: number; s: number; o: number; tw?: string }[] = [];
  while (glints.length < 42) {
    const x = +(rnd() * 1600).toFixed(1), y = +(30 + rnd() * 500).toFixed(1);
    if (inTitle(x, y)) continue;
    const o = +(0.45 + rnd() * 0.45).toFixed(2);
    glints.push({ x, y, s: +(3 + rnd() * 5).toFixed(1), o, ...(rnd() < 0.6 ? { tw: twinkle(o) } : {}) });
  }
  return { dots, glints };
})();

// —— 标题：中文逐字、英文逐词拆成小块，--i 是出场次序；关键词里的块另有 --j（扫光的次序）——
type Piece = { space: string } | { w: string; i: number; j?: number };
let order = 0;
const split = (text: string, mark = false): Piece[] => {
  let j = 0;
  return (isZh ? Array.from(text) : text.split(/(\s+)/)).filter((x) => x !== "").map((x) => (/^\s+$/.test(x) ? { space: x } : { w: x, i: order++, ...(mark ? { j: j++ } : {}) }));
};
const lineA = split(t.hero.h1a);
const nA = order;
const lineB = { pre: split(t.hero.h1pre), mark: split(t.hero.h1mark, true), post: split(t.hero.h1b) };
const h1Style = `--na:${nA};--nt:${order};--step:${isZh ? 45 : 80}ms`;

// —— 舞台时间线（毫秒）——
const LOOP = 18000;
const FLOW = 3000; // 一张卡从泳道左外侧走到右外侧
// 整幕：a 天天 0–6s · b 飞飞 6–12s · c 芽芽 12–18s；"busy" 是机器人在干活（侧栏亮绿点、发送钮变停止、窗口里的头像进入工作状态）
const steps = JSON.stringify([[0, "a"], [1100, "a busy"], [4800, "a"], [6000, "b"], [6900, "b busy"], [10600, "b"], [12000, "c"], [12900, "c busy"], [15200, "c"]]);
const cast: { k: CharKey; step: "a" | "b" | "c"; model: string; busy: [number, number] }[] = [
  { k: "blue", step: "a", model: "claude-sonnet-5-5", busy: [1100, 4800] },
  { k: "orange", step: "b", model: "gpt-5.6-sol", busy: [6900, 10600] },
  { k: "green", step: "c", model: "deepseek-v4-flash", busy: [12900, 15200] },
];
const botStates = (b: [number, number]) => JSON.stringify([[0, "idle"], [b[0], "working"], [b[1], "idle"]]);
// 侧栏：三位主演 + 两位路人；时间是示意
const rows: { k: CharKey; when: string }[] = [
  { k: "blue", when: "21:08" }, { k: "orange", when: "20:46" }, { k: "green", when: "18:30" }, { k: "red", when: "17:52" }, { k: "purple", when: "09:15" },
];
const cps = isZh ? 30 : 44; // 回复逐字打出的速度：英文字母多，快一点，两种语言差不多同时写完

// 两侧流动的卡片：in 从左边流进窗口，out 从窗口后面流向右边；全程都要在 LOOP 之前走完，回绕时才看不出跳变。
// y / r / s：起止的纵向偏移（泳道高度的百分之几，不带单位）、角度（deg）、缩放。
type Kind = "model" | "msg" | "file" | "done" | "code" | "memory";
interface Card { side: "in" | "out"; at: number; kind: Kind; text?: string; label?: string; dot?: string; y: [number, number]; r: [number, number]; s?: [number, number] }
const cards: Card[] = [
  { side: "in", at: 0, kind: "model", text: "claude-sonnet-5-5", dot: "var(--bot-orange-glow)", y: [-34, -6], r: [12, 2] },
  { side: "in", at: 500, kind: "msg", text: u.chatUser, y: [30, 4], r: [-14, -2] },
  { side: "in", at: 1200, kind: "model", text: "gemini-3.5-flash", dot: "var(--bot-blue-glow)", y: [6, -2], r: [-4, -1], s: [1.06, .9] },
  { side: "out", at: 3300, kind: "code", y: [-2, -28], r: [-2, -10], s: [.9, 1] },
  { side: "out", at: 4000, kind: "done", text: s.fixed, y: [6, 30], r: [2, 10], s: [.9, 1] },

  { side: "in", at: 5000, kind: "model", text: "gpt-5.6-sol", dot: "var(--bot-green-glow)", y: [-30, -4], r: [10, 2] },
  { side: "in", at: 5700, kind: "msg", text: s.task, y: [32, 6], r: [-12, -2] },
  { side: "in", at: 6400, kind: "file", text: s.invoice, y: [0, -4], r: [-5, -1], s: [1.06, .9] },
  { side: "out", at: 9600, kind: "file", text: t.handson.file, y: [0, -26], r: [-2, -9], s: [.9, 1] },
  { side: "out", at: 10300, kind: "done", text: s.moved, y: [6, 30], r: [3, 11], s: [.9, 1] },

  { side: "in", at: 11000, kind: "model", text: "deepseek-v4-flash", dot: "var(--bot-purple-glow)", y: [-32, -4], r: [12, 2] },
  { side: "in", at: 11700, kind: "msg", label: u.imFrom, text: u.imUser, y: [28, 4], r: [-12, -2] },
  { side: "out", at: 14200, kind: "memory", text: s.saved, y: [0, -26], r: [-2, -10], s: [.9, 1] },
  { side: "out", at: 14900, kind: "done", text: s.digest, y: [6, 30], r: [2, 10], s: [.9, 1] },
];
const flowStyle = (c: Card) => [
  `--y0:${c.y[0]}`, `--y1:${c.y[1]}`, `--r0:${c.r[0]}deg`, `--r1:${c.r[1]}deg`,
  ...(c.s ? [`--s0:${c.s[0]}`, `--s1:${c.s[1]}`] : []), ...(c.dot ? [`--dot:${c.dot}`] : []),
].join(";");

// App 里的线稿图标（ui/design 的图标：细线、圆头），只在窗口里用
const I = {
  plus: '<path d="M12 5v14M5 12h14"/>',
  edit: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  panel: '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M15 4v16"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4-4"/>',
  gear: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/>',
  shield: '<path d="M12 3.5 19 6v5.5c0 4.2-3 7.6-7 9-4-1.4-7-4.8-7-9V6l7-2.5Z"/>',
  down: '<path d="m6 9 6 6 6-6"/>',
  up: '<path d="M12 19V5M5 12l7-7 7 7"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  doc: '<path d="M7 3.5h6.5L18 8v11a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 6 19V5a1.5 1.5 0 0 1 1-1.5Z"/><path d="M13 3.5V8h5M9 12.5h6M9 16h4"/>',
  memory: '<path d="M12 4.5 19.5 8 12 11.5 4.5 8 12 4.5Z"/><path d="m4.5 12 7.5 3.5 7.5-3.5M4.5 16l7.5 3.5 7.5-3.5"/>',
};
const ic = (d: string, size = 16, cls = "aic") => `<svg class="${cls}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
---
<section class="hero" aria-labelledby="hero-h1">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__beam"></div>
    <div class="hero__sky">
      <svg class="hero__stars" viewBox="0 0 1600 640" preserveAspectRatio="xMidYMin slice" focusable="false">
        <g class="hero__dots">{sky.dots.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o} class:list={[s.cls, { tw: s.tw }]} style={s.tw} />)}</g>
        <g class="hero__glints">{sky.glints.map((g) => <g transform={`translate(${g.x} ${g.y})`}><path d={GLINT} opacity={g.o} class:list={[{ tw: g.tw }]} style={`--s:${g.s};${g.tw ?? ""}`} /></g>)}</g>
      </svg>
      <div class="hero__clouds">
        <i class="hero__cloud" style="--y:36px;--w:540px;--x0:6cqw;--c:170s;--t:-38s"></i>
        <i class="hero__cloud" style="--y:150px;--w:380px;--x0:58cqw;--c:220s;--t:-150s;--o:.75"></i>
        <i class="hero__cloud" style="--y:4px;--w:660px;--x0:72cqw;--c:280s;--t:-226s;--o:.85"></i>
      </div>
      <i class="hero__meteor" style="--x:16%;--y:64px;--c:13s;--w:4s"></i>
      <i class="hero__meteor" style="--x:60%;--y:132px;--c:21s;--w:12s"></i>
    </div>
    <HeroLogos />
    <div class="hero__aura"></div>
    <div class="hero__glow"></div>
    <div class="hero__horizon"></div>
  </div>

  <div class="container hero__inner">
    <a class="hero__eyebrow" href="#bots">
      <span class="hero__crew">{CHAR_KEYS.map((k) => <BotFace char={k} size={22} />)}</span>
      <span>{t.hero.eyebrow}</span>
      <Icon name="arrow" size={14} />
    </a>
    <h1 class="hero__h1" id="hero-h1" style={h1Style}>
      <span class="sr-only">{t.hero.h1a} {t.hero.h1pre}{t.hero.h1mark}{t.hero.h1b}</span>
      <span class="hero__line hero__line--a" aria-hidden="true">{lineA.map((p) => ("space" in p ? p.space : <span class="hero__c" style={`--i:${p.i}`}>{p.w}</span>))}<BotFace char="blue" size={80} lively pokeable class="hero__bot" /></span>
      <span class="hero__line hero__line--b" aria-hidden="true">
        {lineB.pre.map((p) => ("space" in p ? p.space : <span class="hero__c" style={`--i:${p.i}`}>{p.w}</span>))}<em class="hero__em">{lineB.mark.map((p) => ("space" in p ? p.space : <span class="hero__c" style={`--i:${p.i};--j:${p.j}`}>{p.w}</span>))}</em>{lineB.post.map((p) => ("space" in p ? p.space : <span class="hero__c" style={`--i:${p.i}`}>{p.w}</span>))}
      </span>
    </h1>
    <p class="lead hero__lead">{fmt(t.hero.lead, v)}</p>
    <div class="hero__cta">
      <DownloadButton lang={lang} placement="hero" id="cta-hero">
        <button slot="after" class="btn btn--secondary" type="button" data-open-dialog="demo-tour" data-track="video_play" data-track-video_id="overview"><Icon name="play" />{t.hero.demo}</button>
      </DownloadButton>
    </div>
    <ul class="hero__meta" role="list">{meta.map((x) => <li><Icon name="check" size={14} />{x}</li>)}</ul>
  </div>

  <div class="hstage" aria-hidden="true" data-loop={LOOP} data-loop-threshold="0.05">
    {(["in", "out"] as const).map((lane) => (
      <div class={`hstage__lane hstage__lane--${lane}`}>
        {cards.filter((c) => c.side === lane).map((c) => (
          <div class="hs-flow" data-flow={`${c.at}:${c.at + FLOW}`} style={flowStyle(c)}>
            {c.kind === "model" && <span class="hs-card hs-card--model"><i></i>{c.text}</span>}
            {c.kind === "msg" && <span class="hs-card hs-card--msg">{c.label && <small>{c.label}</small>}{c.text}</span>}
            {c.kind === "file" && <span class="hs-card hs-card--file"><Fragment set:html={ic(I.doc, 16)} />{c.text}</span>}
            {c.kind === "done" && <span class="hs-card hs-card--done"><b><Fragment set:html={ic(I.check, 12)} /></b>{c.text}</span>}
            {c.kind === "memory" && <span class="hs-card hs-card--memory"><Fragment set:html={ic(I.memory, 16)} />{c.text}</span>}
            {c.kind === "code" && <span class="hs-card hs-card--code"><del>- for (i = 0; i &lt;= len; i++)</del><ins>+ for (i = 0; i &lt; len; i++)</ins></span>}
          </div>
        ))}
      </div>
    ))}

    <div class="hstage__devices" data-steps={steps} data-fx data-fx-to="0.2">
      <!-- App 窗口：环境光 → 毛玻璃侧栏 | 浮起的主面板（顶栏 → 对话 → 玻璃输入框），照 ui/css/shell.css、chat.css -->
      <div class="awin">
        <div class="awin__side">
          <div class="awin__top"><span class="awin__lights"><i></i><i></i><i></i></span><span class="awin__ib"><Fragment set:html={ic(I.plus)} /></span></div>
          <div class="awin__search"><Fragment set:html={ic(I.search, 14)} />{s.search}</div>
          <div class="awin__list">
            {rows.map((r) => (
              <div class="awin__row" data-bot={r.k}>
                <span class="awin__av"><BotFace char={r.k} size={34} /><i class="awin__dot"></i></span>
                <span class="awin__body">
                  <span class="awin__line"><b>{bots[r.k].name}</b><small>{r.when}</small></span>
                  <span class="awin__snip"><span>{bots[r.k].bot}</span><span class="awin__snip-busy">{s.working}</span></span>
                </span>
              </div>
            ))}
          </div>
          <div class="awin__acct"><span class="awin__me">{s.account.slice(0, 1).toUpperCase()}</span><span class="awin__who">{s.account}<small>{s.balance} $12.40</small></span><Fragment set:html={ic(I.gear)} /></div>
        </div>

        <div class="awin__main">
          <div class="awin__head">
            <span class="by-step awin__hb">
              {cast.map((c) => <span data-for={c.step}><BotFace char={c.k} size={24} data-states={botStates(c.busy)} data-shots={JSON.stringify([[c.busy[1], "done"]])} /><b>{bots[c.k].name}</b></span>)}
            </span>
            <span class="awin__grow"></span>
            <span class="awin__ib"><Fragment set:html={ic(I.edit)} /></span>
            <span class="awin__ib"><Fragment set:html={ic(I.panel)} /></span>
          </div>

          <div class="by-step awin__views">
            <!-- 一幕 天天：聊天改代码 -->
            <div class="awin__view hs-log" data-for="a">
              <div class="hs-item hs-item--static"><div><p class="amsg amsg--user">{bots.blue.user}</p></div></div>
              <div class="hs-item hs-item--static"><div><p class="amsg">{bots.blue.bot}</p></div></div>
              <div class="hs-item" data-at="400"><div><p class="amsg amsg--user">{u.chatUser}</p></div></div>
              <div class="hs-item" data-at="1100"><div><p class="awork"><span class="by-time"><span class="awork__live">{s.thinking}</span><span data-at="2400">{fmt(s.took, { s: "1.3s" })}</span></span></p></div></div>
              <div class="hs-item" data-at="2400"><div><p class="amsg awin__live"><span data-at="2400" data-type={u.chatReply} data-cps={cps}></span></p></div></div>
              <div class="hs-item" data-at="4300"><div><div class="acode"><span class="acode__bar">c</span><pre><del>- for (i = 0; i &lt;= len; i++)</del>
<ins>+ for (i = 0; i &lt; len; i++)</ins></pre></div></div></div>
            </div>
            <!-- 二幕 飞飞：动手整理文件，越界要你批准 -->
            <div class="awin__view hs-log" data-for="b">
              <div class="hs-item hs-item--static"><div><p class="amsg amsg--user">{bots.orange.user}</p></div></div>
              <div class="hs-item hs-item--static"><div><p class="amsg">{bots.orange.bot}</p></div></div>
              <div class="hs-item" data-at="6400"><div><p class="amsg amsg--user">{s.task}</p></div></div>
              <div class="hs-item" data-at="6900"><div><p class="awork"><span class="by-time"><span class="awork__live">{s.thinking}</span><span data-at="10400">{fmt(s.took, { s: "3.5s" })}</span></span></p></div></div>
              <div class="hs-item" data-at="7300"><div><ul class="awell asteps" role="list">{t.handson.demoSteps.map((x, i) => <li data-at={String(7300 + i * 500)}><Fragment set:html={ic(I.check, 13)} />{x}</li>)}</ul></div></div>
              <div class="hs-item" data-at="8800"><div><div class="awell aapprove" data-at="10000">
                <span class="aapprove__meta">{t.window.approvalTitle}</span>
                <b>{t.handson.approvalBody}</b>
                <span class="aapprove__row"><span class="abtn abtn--primary" data-at="9700">{t.window.allow}</span><span class="abtn">{t.window.deny}</span></span>
                <span class="aapprove__done"><Fragment set:html={ic(I.check, 13)} />{s.allowed}</span>
              </div></div></div>
              <div class="hs-item" data-at="10500"><div><div class="awell afile"><Fragment set:html={ic(I.doc, 24)} /><span><b>{t.handson.file}</b><small>{s.fileSub}</small></span></div></div></div>
            </div>
            <!-- 三幕 芽芽：聊天软件里来的消息，回完存进记忆 -->
            <div class="awin__view hs-log" data-for="c">
              <div class="hs-item hs-item--static"><div><span class="atime">{t.bots.phoneDay}</span></div></div>
              <div class="hs-item" data-at="12400"><div><p class="amsg amsg--user"><small>{u.imFrom}</small>{u.imUser}</p></div></div>
              <div class="hs-item" data-at="12900"><div><p class="awork"><span class="by-time"><span class="awork__live">{s.thinking}</span><span data-at="13800">{fmt(s.took, { s: "0.9s" })}</span></span></p></div></div>
              <div class="hs-item" data-at="13800"><div><p class="amsg awin__live"><span data-at="13800" data-type={u.imReply} data-cps={cps - 4}></span></p></div></div>
              <div class="hs-item" data-at="15200"><div><span class="awell anote"><Fragment set:html={ic(I.memory, 14)} />{s.saved}</span></div></div>
            </div>
          </div>

          <div class="awin__composer">
            <span class="by-step awin__ph">{cast.map((c) => <span data-for={c.step}>{fmt(s.input, { name: bots[c.k].name })}</span>)}</span>
            <span class="awin__bar">
              <span class="awin__plus"><Fragment set:html={ic(I.plus)} /></span>
              <span class="awin__chip"><Fragment set:html={ic(I.shield, 13)} />{s.perm}<Fragment set:html={ic(I.down, 11)} /></span>
              <span class="awin__grow"></span>
              <span class="awin__chip"><span class="by-step">{cast.map((c) => <span data-for={c.step}>{c.model}</span>)}</span><Fragment set:html={ic(I.down, 11)} /></span>
              <span class="awin__send"><Fragment set:html={ic(I.up, 15)} /><i></i></span>
            </span>
          </div>
        </div>
      </div>

      <!-- 手机：芽芽在聊天软件里，第三幕和窗口同步 -->
      <div class="phone hstage__phone">
        <div class="phone__screen">
          <div class="phone__head"><BotFace char="green" size={26} data-states={botStates([12900, 15200])} />{bots.green.name} · {u.imFrom}</div>
          <div class="phone__log hs-log">
            <div class="hs-item hs-item--static"><div><span class="phone__day">{t.bots.phoneDay}</span></div></div>
            <div class="hs-item hs-item--static"><div><p class="msg msg--user">{s.phoneUser}</p></div></div>
            <div class="hs-item hs-item--static"><div><p class="msg msg--bot">{s.phoneBot}</p></div></div>
            <div class="hs-item" data-at="12200"><div><p class="msg msg--user">{u.imUser}</p></div></div>
            <div class="hs-item" data-at="13800"><div><p class="msg msg--bot"><span data-at="13800" data-type={u.imReply} data-cps={cps - 4}></span></p></div></div>
          </div>
          <div class="phone__input">{t.bots.phoneInput}</div>
        </div>
      </div>
    </div>
  </div>
</section>
