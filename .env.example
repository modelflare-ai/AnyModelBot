# anymodel bot 环境变量（全部可选；环境变量优先于 <数据目录>/config.json）
# 复制为 .env 后由你的进程管理器/`docker run --env-file` 加载（程序本身不自动读取 .env）

# 数据目录（SQLite、magpie 隔离配置、微信登录态）。默认 ./data；桌面版默认 <userData>/data
# AMB_DATA_DIR=./data

# 管理界面。非回环地址（如 0.0.0.0）会强制令牌访问，令牌见 <数据目录>/ui-token
# AMB_UI_HOST=127.0.0.1
# AMB_UI_PORT=3600
# AMB_UI_TOKEN=

# 内置 magpie 可执行文件（默认自动查找 build/bin 或桌面版 resources/magpie）
# AMB_MAGPIE_BIN=
# 改用外部 OpenAI 兼容端点（设置后不启动内置 magpie，“模型”页不可用）
# AMB_MAGPIE_BASE_URL=http://127.0.0.1:8080/v1
# AMB_MAGPIE_API_KEY=

# 对话
# AMB_DEFAULT_MODEL=deepseek/deepseek-chat
# AMB_CONTEXT_MESSAGES=40
# AMB_CONTEXT_CHARS=24000

# 飞书（仅首次创建默认机器人时读取；之后在界面「渠道」页修改）
# FEISHU_APP_ID=cli_xxx
# FEISHU_APP_SECRET=
# AMB_FEISHU_THROTTLE_MS=400

# 微信 iLink 接口地址（一般不用改）
# AMB_WEIXIN_API_BASE=https://ilinkai.weixin.qq.com

# 日志级别 debug|info|warn|error
# AMB_LOG_LEVEL=info
