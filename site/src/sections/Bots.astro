---
// 认识你的机器人（§6.9）："给每个机器人一份工作"——工作是用户给的，所以发工牌，右上角写"岗位自定"。六个角色只有名字和长相不同（和 App 的新建页一致）。
// 工牌上的岗位、人设、模型和手机里的对话都是示例（i18n 的 bots.personas，对应关系在 lib/bots.ts 的 CHAR_PERSONA），舞台下面那行小字说明了这一点。
// 一排角色下面只写英文名，不写岗位：那一排最容易读成"每个角色固定干什么"（用户 2026-11-01 纠正过）；也不写配饰，用户说过没有意义。
// 这版工牌的版式不要改，字数也要合得上：每张工牌第一行各不相同、人设一行放下、不叠多行灰字（用户同一天觉得字多、千篇一律就没有原来好看）。
// 章节头 → 一张大舞台卡：最上面一排六个角色（WAI-ARIA tabs，选中的那个"在岗"，其余几个转头看它）；
// 细线下垂下一根挂绳，挂着当前角色的工牌（证件照是会动、能戳的大头像，月薪 = 日常用量的月估算）；
// 右边是手机里的对话，中间一条电脑 ↔ 手机的连线（微信 / 飞书）。卡片下面三条手机端的好处。
// 交互在 scripts/sections.ts：换角色时工牌翻面、挂绳晃一晃，鼠标拨一下工牌也会晃；手机里的回复逐字打出；
// 舞台卡底光和挂绳随角色换色；窄屏上纵向排列，左右滑动舞台也能换角色。
// 月薪 = 计算器"日常"预设 × 默认线路价；点开去 /pricing 的计算器，并带上这个模型（计算器读 ?m=）。
// 名字：每个角色的中英文名都取自它最显眼的那件配饰（天天 Ping ← 天线、闪闪 Twinkle ← 星星、芽芽 Sprout ← 嫩芽、
// 哒哒 Beat ← 耳机、晶晶 Crystal ← 水晶、飞飞 Pilot ← 飞行护目镜）。中文页工牌上名字旁边写着英文名（alias）；英文页不写中文名（alias 留空，页面上不出现中文），
// 座右铭讲名字的由来。证件照上不加任何标注（以前有一个指向配饰的小标签，用户 2026-10-31 要求去掉：没有意义）。
import BotFace from "../components/BotFace.astro";
import EyesMark from "../components/EyesMark.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import { dict, fmt, href, type Lang } from "../i18n";
import { CHAR_KEYS, CHAR_PERSONA, type CharKey } from "../lib/bots";
import { personaModels } from "../data/pricing.config";
import { rowOf } from "../lib/site";
import { estimate, fmtMoney, PRESETS } from "../lib/calc";
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dict(lang);
const b = t.bots;
const L = b.looks;
const talk = (k: CharKey) => b.personas[CHAR_PERSONA[k]];
const modelOf = (k: CharKey) => personaModels[CHAR_PERSONA[k]];
const pricingPage = href(lang, "/pricing");
const cost = (k: CharKey) => {
  const r = rowOf(modelOf(k));
  return r ? fmtMoney(estimate(r, { group: r.defaultGroup, ...PRESETS.everyday }).monthly) : "—";
};
// 工牌底部的条形码：按角色名算出来的伪随机竖条，纯装饰
const barcode = (k: string) => {
  let h = [...k].reduce((a, c) => (a * 31 + c.charCodeAt(0)) >>> 0, 7);
  const bars: [number, number][] = [];
  for (let x = 0; x < 118;) {
    h = (Math.imul(h, 1103515245) + 12345) >>> 0;
    const w = 1 + ((h >>> 16) % 3);
    bars.push([x, w]);
    x += w + 1 + ((h >>> 8) % 3);
  }
  return bars;
};
const perkIcons = ["doc", "layers", "plus"] as const;
---
<section class="section" id="bots" aria-labelledby="bots-h2">
  <div class="container">
    <SectionHead n={2} label={t.kicker.bots} id="bots-h2" title={b.h2} dim={b.h2dim} lead={b.lead} />

    <div class="crew fx-rise" data-crew data-char={CHAR_KEYS[0]} data-doze data-fx>
      <div class="lineup" role="tablist" aria-label={b.tabsLabel} data-bot-tabs>
        {CHAR_KEYS.map((k, i) => (
          <button type="button" role="tab" class="lineup__bot bot-hover" id={`bt-${k}`} aria-selected={i === 0 ? "true" : "false"} aria-controls={`bp-${k}`} tabindex={i === 0 ? 0 : -1} data-bot={k} style={`--c:var(--bot-${k}-glow)`}>
            <BotFace char={k} size={64} lively />
            <span class="lineup__name">{L[k].name}</span>
            <span class="lineup__job" aria-hidden="true"><span lang="en">{L[k].alias}</span><span class="lineup__duty">{b.badge.onDuty}</span></span>
          </button>
        ))}
      </div>

      <div class="crew__stage" data-bot-stage>
        <div class="crew__badge">
          <div class="badge-hang" data-badge>
            <span class="badge-hang__strap" aria-hidden="true"></span>
            <span class="badge-hang__clip" aria-hidden="true"></span>
            <div class="badge-card" data-badge-card>
              <div class="badge-card__top" aria-hidden="true">
                <span class="badge-card__org"><EyesMark size={16} />{b.badge.org}</span>
                <span class="badge-card__staff">{b.badge.staff}</span>
              </div>
              {CHAR_KEYS.map((k, i) => (
                <div class="badge-card__panel" role="tabpanel" id={`bp-${k}`} aria-labelledby={`bt-${k}`} hidden={i !== 0} data-panel={k} style={`--c:var(--bot-${k}-glow)`}>
                  <div class="badge-card__photo">
                    <BotFace char={k} size={176} lively pokeable />
                  </div>
                  <div class="badge-card__id">
                    <p class="badge-card__job eyebrow">{talk(k).job}</p>
                    <h3 class="badge-card__name subhead">{L[k].name}{L[k].alias && <> <span class="badge-card__alias" lang="en">{L[k].alias}</span></>}</h3>
                    <p class="badge-card__motto">{L[k].motto}</p>
                  </div>
                  <dl class="badge-card__fields">
                    <div><dt>{b.badge.persona}</dt><dd>{talk(k).persona}</dd></div>
                    <div><dt>{b.badge.model}</dt><dd><span class="mono">{modelOf(k)}</span><small>{b.modelNote}</small></dd></div>
                    <div><dt>{b.badge.salary}</dt><dd>
                      <a class="mono" href={`${pricingPage}?m=${modelOf(k)}#calc`} data-track="bot_cost_click" data-track-bot_id={k} data-track-model_id={modelOf(k)}>{fmt(b.cost, { amount: cost(k) })}<Icon name="arrow" size={14} /></a>
                      <small>{b.badge.salaryNote}</small>
                    </dd></div>
                  </dl>
                  <div class="badge-card__foot" aria-hidden="true">
                    <svg viewBox="0 0 120 22" preserveAspectRatio="none">{barcode(k).map(([x, w]) => <rect x={x} y="0" width={w} height="22" />)}</svg>
                    <span class="mono">{b.badge.no} · AMB-{String(i + 1).padStart(3, "0")}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <p class="crew__where"><Icon name="devices" size={16} />{b.where.pc}</p>
        </div>

        <div class="crew__link" aria-hidden="true">
          <span class="crew__wire"><i></i></span>
          <span class="crew__wire-label">{b.link}</span>
        </div>

        <div class="crew__phone">
          <div class="phone phone--full" aria-hidden="true">
            <div class="phone__screen">
              <div class="phone__status">
                <span>9:41</span><i class="phone__island"></i>
                <svg class="phone__sys" viewBox="0 0 63 12" fill="currentColor">
                  <rect x="0" y="8" width="3" height="4" rx=".8" /><rect x="5" y="5.5" width="3" height="6.5" rx=".8" /><rect x="10" y="3" width="3" height="9" rx=".8" /><rect x="15" y="0" width="3" height="12" rx=".8" />
                  <g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M26.6 7.6a4.8 4.8 0 0 1 6.8 0" /><path d="M24.2 5.1a8.2 8.2 0 0 1 11.6 0" /></g><circle cx="30" cy="10.2" r="1.3" />
                  <rect x="40.5" y="1" width="19" height="10" rx="3" fill="none" stroke="currentColor" stroke-width="1" opacity=".45" /><rect x="42.5" y="3" width="13" height="6" rx="1.5" /><rect x="60.5" y="4" width="1.5" height="4" rx=".75" opacity=".45" />
                </svg>
              </div>
              {CHAR_KEYS.map((k, i) => (
                <div class="phone__view" data-phone={k} hidden={i !== 0}>
                  <div class="phone__head">
                    <Icon name="chevron" class="phone__back" size={18} />
                    <BotFace char={k} size={36} />
                    <span class="phone__who"><b>{L[k].name}</b><small>{b.phoneStatus}</small></span>
                  </div>
                  <div class="phone__log">
                    <span class="phone__day">{b.phoneDay}</span>
                    <p class="msg msg--user">{talk(k).user}</p>
                    <div class="phone__reply"><BotFace char={k} size={26} /><p class="msg msg--bot">{talk(k).bot}</p></div>
                  </div>
                </div>
              ))}
              <div class="phone__input"><i class="phone__plus"></i><span>{b.phoneInput}</span><i class="phone__send"></i></div>
              <i class="phone__home"></i>
            </div>
          </div>
          <p class="crew__where"><Icon name="chat" size={16} />{b.where.phone}</p>
        </div>
      </div>
      <p class="crew__note small muted">{b.phoneNote}<span class="crew__swipe"> · {b.swipeHint}</span></p>
    </div>

    <ul class="crew-perks" role="list">
      {b.perks.map((p, i) => (
        <li class="reveal" style={`--reveal-delay:${i * 80}ms`}>
          <span class="crew-perks__ico"><Icon name={perkIcons[i]} /></span>
          <b>{p.title}</b>
          <span>{p.body}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
